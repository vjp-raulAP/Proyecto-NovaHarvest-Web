@page "/ticket"
@model TicketModel
@{
    Layout = null;

}

<!DOCTYPE html>
    <html lang= "es">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content= "width=device-width, initial-scale=1.0">
            <title>Justificante de reserva - NovaHarvest</title>
            <link rel="stylesheet" href="/css/site.css">
        </head>

        <body>
            <main>
                <h1>Justificante de Reserva</h1>
                <p>Reserva: @Model.ReservationsCode</p>
                <p>Producto: @Model.Product</p>
                <p>Kilos: @Model.Kilos</p>
                <p>Recogida: @Model.HarvestPlace </p>
                <p>Generado el @Model.GenerateDay.ToString("dd/MM/yyyy HH:mm") (fecha y hora del servidor)</p>
            </main>    
        </body>
    </html>